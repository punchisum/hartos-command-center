# .env.production.example
# Production environment configuration for test-agent
# Copy to .env.production.local and fill in values.
# Never commit .env.production.local or any file with real secrets.
# Production secrets are typically set via Cloudflare dashboard (wrangler secret put).

APP_ENV=production

# Supabase — production project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_REGION=us-east-1
ALLOW_SUPABASE_PROJECT_CREATE=false

# Telegram — production bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# OpenAI
OPENAI_API_KEY=

# Trigger.dev — production project
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_ENVIRONMENT=production
TRIGGER_EXPECTED_TASKS=
ALLOW_TRIGGER_TASK_REGISTER=false
ALLOW_TRIGGER_DEPLOY=false

# Cloudflare — production Worker URL (after deploy)
CLOUDFLARE_WORKER_URL=
PRODUCTION_CLOUDFLARE_WORKER_URL=
PRODUCTION_TELEGRAM_WEBHOOK_URL=

# Debug
ENABLE_DEBUG_EVENTS=true
DEBUG_CHANNEL_ID=

# Smoke gates — production smoke is read-only, no mutations
ALLOW_LIVE_SMOKE_MUTATION=false
ALLOW_TELEGRAM_TEST_SEND=false

# Phase 5: Deployment gates — set ALL of these explicitly before production deploy
# These are NEVER pre-filled. Set them only after reviewing the migration plan and staging smoke.
ALLOW_SUPABASE_MIGRATION_APPLY=false
ALLOW_CLOUDFLARE_DEPLOY=false
ALLOW_TELEGRAM_WEBHOOK_REGISTER=false
CONFIRM_PRODUCTION_DEPLOY=false

# Phase 6: provisioning gates
ALLOW_AUTO_PROVISION=false
CONFIRM_STAGING_PROVISION=false
ALLOW_GITHUB_PROVISION=false
ALLOW_SUPABASE_PROVISION=false
ALLOW_CLOUDFLARE_PROVISION=false
ALLOW_TRIGGER_PROVISION=false
ALLOW_TELEGRAM_PROVISION=false
ALLOW_OPENAI_VERIFY=false
# Phase 7A: GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_NAME=
GITHUB_PRIVATE_REPO=true
GITHUB_DEFAULT_BRANCH=main
ALLOW_GITHUB_PUSH=false
# Phase 7A: OpenAI
OPENAI_MODEL=gpt-4o
# Phase 7B: Cloudflare provisioning
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ROUTE=
CLOUDFLARE_ENVIRONMENT=production
ALLOW_CLOUDFLARE_SECRET_UPLOAD=false

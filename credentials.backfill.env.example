# ═══════════════════════════════════════════════════════════════════════════
# HARTOS credential backfill — ONE file, ONE command.
#
#   1. Fill the blanks below (most values are already prefilled).
#   2. Run:  bash scripts/apply-credentials.sh
#
# This file is GITIGNORED. Never commit it.
# Prefilled values were prefilled by the audit session where possible.
# The apply script needs wrangler authenticated (wrangler login, or
# CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID exported).
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Cockpit Worker data feeds (fixes the live 401s) ─────────────────────
# Non-secret URLs — prefilled.
HARTOS_OPS_SUPABASE_URL=https://tbdkveyixqjksamcdemr.supabase.co
HARTOS_FITNESS_SUPABASE_URL=https://xbuinrnpfjltimofwrdx.supabase.co

# Read-only ANON keys — prefilled from your projects (GECAN OPS + Hart
# Personal Core). These are client-side keys, NOT service-role keys.
HARTOS_OPS_SUPABASE_READONLY_KEY=
HARTOS_FITNESS_SUPABASE_READONLY_KEY=

# Fitness scoping ids (non-secret uuids). The ONLY two values you must dig up.
# Supabase dashboard → Hart Personal Core → SQL editor → run:
#   select user_id, agent_id from fitness_user_config limit 1;
HARTOS_FITNESS_USER_ID=
HARTOS_FITNESS_AGENT_ID=

# ── 2. Cockpit login token ──────────────────────────────────────────────────
# Leave BLANK to auto-generate a strong token on apply (it will be printed
# once — this is what you type into the cockpit login screen).
HARTOS_COCKPIT_ACCESS_TOKEN=

# ── 3. GECAN webhook fail-open fix (optional but recommended) ──────────────
# Leave the secret BLANK to auto-generate. To also re-register the Telegram
# webhook with the new secret (required for Telegram to keep working), fill
# the bot token + the webhook URL the bot currently posts to.
GECAN_TELEGRAM_WEBHOOK_SECRET=
GECAN_TELEGRAM_BOT_TOKEN=
GECAN_TELEGRAM_WEBHOOK_URL=

# ── 4. CI staging deploy (optional — enables "merged = deployed") ──────────
# Requires the gh CLI authenticated. Set to true to push the values above
# (plus any extra secrets you export) into GitHub Actions secrets and flip
# the ENABLE_STAGING_DEPLOY repo variable.
SETUP_GITHUB_STAGING_DEPLOY=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_REGION=us-east-1
ALLOW_SUPABASE_PROJECT_CREATE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BOT_NAME=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEBUG_CHANNEL_ID=
TEST_TELEGRAM_CHAT_ID=
TRIGGER_SECRET_KEY=
CLOUDFLARE_WORKER_URL=
ENABLE_DEBUG_EVENTS=true
ALLOW_LIVE_SMOKE_MUTATION=false
ALLOW_TELEGRAM_TEST_SEND=false
APP_ENV=local
# Phase 5: staging profile
STAGING_SUPABASE_URL=
STAGING_CLOUDFLARE_WORKER_URL=
STAGING_TELEGRAM_WEBHOOK_URL=
# Phase 5: production profile
PRODUCTION_SUPABASE_URL=
PRODUCTION_CLOUDFLARE_WORKER_URL=
PRODUCTION_TELEGRAM_WEBHOOK_URL=
# Phase 5: deployment gates (never true by default)
ALLOW_SUPABASE_MIGRATION_APPLY=false
ALLOW_CLOUDFLARE_DEPLOY=false
ALLOW_TELEGRAM_WEBHOOK_REGISTER=false
CONFIRM_PRODUCTION_DEPLOY=false
# Phase 6: provisioning gates (never true by default)
ALLOW_AUTO_PROVISION=false
CONFIRM_STAGING_PROVISION=false
ALLOW_GITHUB_PROVISION=false
ALLOW_SUPABASE_PROVISION=false
ALLOW_CLOUDFLARE_PROVISION=false
ALLOW_TRIGGER_PROVISION=false
ALLOW_TELEGRAM_PROVISION=false
ALLOW_OPENAI_VERIFY=false
# Phase 7A: GitHub provisioning
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_ORG=
GITHUB_REPO_NAME=
GITHUB_PRIVATE_REPO=true
GITHUB_DEFAULT_BRANCH=main
GITHUB_DESCRIPTION=
GITHUB_HOMEPAGE=
ALLOW_GITHUB_PUSH=false
# Phase 7B: Cloudflare provisioning
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ROUTE=
CLOUDFLARE_ENVIRONMENT=staging
ALLOW_CLOUDFLARE_SECRET_UPLOAD=false
# Phase 7E: Trigger.dev provisioning
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_ENVIRONMENT=staging
TRIGGER_EXPECTED_TASKS=
ALLOW_TRIGGER_TASK_REGISTER=false
ALLOW_TRIGGER_DEPLOY=false
# Phase 9: production promotion gates (never true by default)
ALLOW_PRODUCTION_PROMOTION=false
REQUIRE_STAGING_SUCCESS=true
ALLOW_PARTIAL_STAGING_PROMOTION=false
ALLOW_ROLLBACK_EXECUTION=false
# Phase 10: bootstrap gates (never true by default)
ALLOW_BOOTSTRAP_PROVISION=false
CONFIRM_BOOTSTRAP_PROVISION=false
ALLOW_LAUNCH_NOTIFICATIONS=false
# Phase 11B: Beezulbub live scout
BEEZULBUB_LIVE_SEARCH=false
BEEZULBUB_MAX_CANDIDATES=10
BEEZULBUB_ALLOW_NETWORK=false
BEEZULBUB_ALLOW_CLONE=false
# Phase 11C: Beezulbub pack generation
BEEZULBUB_ALLOW_PACK_GENERATE=false
BEEZULBUB_PACK_OUTPUT_DIR=packs
# Phase 11D: Pack governance + capability registry
BEEZULBUB_ALLOW_PACK_PROMOTE=false
BEEZULBUB_CAPABILITY_REGISTRY_PATH=capabilities/capability-registry.json
BEEZULBUB_PROVENANCE_LEDGER_PATH=capabilities/provenance-ledger.json
# Phase 11E: Pack implementation engine
BEEZULBUB_ALLOW_PACK_IMPLEMENT=false
# Phase 11J: Cloudflare hosted cockpit (deploy gated, blocked by default)
CLOUDFLARE_PROJECT_NAME=
CLOUDFLARE_COCKPIT_URL=
CLOUDFLARE_COCKPIT_ALLOWED_ORIGIN=
CONFIRM_CLOUDFLARE_DEPLOY=false
ALLOW_CLOUDFLARE_COCKPIT_DEPLOY=false
# Phase 16: hosted cockpit (set real values as wrangler secrets, never here)
HARTOS_COCKPIT_ACCESS_TOKEN=
HARTOS_COCKPIT_REQUIRE_AUTH=false
HARTOS_COCKPIT_DEV_AUTH_BYPASS=false
HARTOS_OPS_SUPABASE_URL=
HARTOS_OPS_SUPABASE_READONLY_KEY=
HARTOS_FITNESS_SUPABASE_URL=
HARTOS_FITNESS_SUPABASE_READONLY_KEY=
HARTOS_FITNESS_USER_ID=
HARTOS_FITNESS_AGENT_ID=

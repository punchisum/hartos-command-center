# .env.staging.example
# Staging environment configuration for test-agent
# Copy to .env.staging.local and fill in values.
# Never commit .env.staging.local or any file with real secrets.

APP_ENV=staging

# Supabase — staging project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_REGION=us-east-1
ALLOW_SUPABASE_PROJECT_CREATE=false

# Telegram — staging bot (can be the same bot as production or a separate test bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TEST_TELEGRAM_CHAT_ID=

# OpenAI
OPENAI_API_KEY=

# Trigger.dev — staging project
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_ENVIRONMENT=staging
TRIGGER_EXPECTED_TASKS=
ALLOW_TRIGGER_TASK_REGISTER=false
ALLOW_TRIGGER_DEPLOY=false

# Cloudflare — staging Worker URL (after deploy)
CLOUDFLARE_WORKER_URL=
STAGING_CLOUDFLARE_WORKER_URL=
STAGING_TELEGRAM_WEBHOOK_URL=

# Debug
ENABLE_DEBUG_EVENTS=true
DEBUG_CHANNEL_ID=

# Smoke gates
ALLOW_LIVE_SMOKE_MUTATION=false
ALLOW_TELEGRAM_TEST_SEND=false

# Phase 5: Deployment gates — set explicitly when ready to deploy
ALLOW_SUPABASE_MIGRATION_APPLY=false
ALLOW_CLOUDFLARE_DEPLOY=false
ALLOW_TELEGRAM_WEBHOOK_REGISTER=false
# CONFIRM_PRODUCTION_DEPLOY is NOT set for staging

# Phase 6: provisioning gates
ALLOW_AUTO_PROVISION=false
CONFIRM_STAGING_PROVISION=false
ALLOW_GITHUB_PROVISION=false
ALLOW_SUPABASE_PROVISION=false
ALLOW_CLOUDFLARE_PROVISION=false
ALLOW_TRIGGER_PROVISION=false
ALLOW_TELEGRAM_PROVISION=false
ALLOW_OPENAI_VERIFY=false
# Phase 7A: GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_NAME=
GITHUB_PRIVATE_REPO=true
GITHUB_DEFAULT_BRANCH=main
ALLOW_GITHUB_PUSH=false
# Phase 7A: OpenAI
OPENAI_MODEL=gpt-4o
# Phase 7B: Cloudflare provisioning
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ROUTE=
CLOUDFLARE_ENVIRONMENT=staging
ALLOW_CLOUDFLARE_SECRET_UPLOAD=false
